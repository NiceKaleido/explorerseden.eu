<?php
// Copy this file to local.env.php (already gitignored) for local PHP dev
// servers like MAMP that don't have an easy way to inject real env vars.
// translate/lib/db.php loads it automatically if present; production
// (Portainer) sets these as real container env vars instead and never
// touches this file.

putenv('DATABASE_URL=postgres://eden_translate:password@localhost:5432/eden_translate');
putenv('DISCORD_CLIENT_ID=');
putenv('DISCORD_CLIENT_SECRET=');
putenv('SESSION_SIGNING_KEY=');
putenv('APP_ENV=local');
