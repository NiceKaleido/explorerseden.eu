# Copy to .env for local tooling, or set these as real env vars in your
# Portainer stack / GitHub Actions secrets for production and CI.

# Postgres connection used by the PHP app (translate/lib/db.php).
DATABASE_URL=postgres://eden_translate:password@localhost:5432/eden_translate

# Same database, used by the CI import/export jobs (tools/scripts/import-translation-keys.js,
# tools/scripts/export-translations.js, tools/scripts/db-migrate.js). Usually identical to
# DATABASE_URL, kept separate in case CI needs a different host/network path to reach Postgres.
TRANSLATIONS_DATABASE_URL=postgres://eden_translate:password@localhost:5432/eden_translate

# Discord OAuth app (discord.com/developers/applications).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Signs session cookies. Generate with: openssl rand -hex 32
SESSION_SIGNING_KEY=

# Set to "local" to allow non-HTTPS cookies during local development.
# Leave unset (or anything else) in production.
APP_ENV=local
